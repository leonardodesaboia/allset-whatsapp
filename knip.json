{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/app/**/{page,layout,route}.tsx", "src/app/**/{page,layout,route}.ts"],
  "project": ["src/**/*.ts", "src/**/*.tsx"],
  "ignore": [
    "**/*.test.ts",
    "**/*.integration.test.ts",
    // Ports/implementações da Fase 1 (Task 7) construídos antes de seus
    // consumidores: serão conectados em tarefas futuras (ErrorReporter nos
    // casos de uso/rotas de API; InMemoryStorageProvider em testes
    // unitários rápidos que ainda não existem — hoje só há cobertura via
    // local-storage-provider.test.ts).
    "src/domain/ports/error-reporter.ts",
    "src/infrastructure/observability/console-error-reporter.ts",
    "src/infrastructure/storage/in-memory-storage-provider.ts"
  ],
  "ignoreDependencies": [
    // Tailwind v4 (@tailwindcss/postcss) já faz autoprefixing via Lightning
    // CSS internamente; pacote mantido do scaffold do Task 1, sem uso direto.
    "autoprefixer",
    // Formatação via IDE/editor (.prettierrc.json presente); nenhum script
    // "format" ainda o invoca diretamente.
    "prettier",
    // Referenciado apenas em anotação de tipo JSDoc no postcss.config.mjs;
    // é dependência transitiva do postcss, não precisa ser listada direto.
    "postcss-load-config",
    // Usado em tests/integration/test-db.ts (harness Testcontainers da
    // Task 3), fora do escopo "src/**" declarado em "project" acima.
    "@testcontainers/postgresql"
  ],
  "ignoreBinaries": [
    // O script "test:e2e" antecipa a Task 10 (E2E de login), que instalará
    // @playwright/test; o binário ainda não está presente propositalmente.
    "playwright"
  ]
}
