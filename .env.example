DATABASE_URL="postgresql://allset:allset@localhost:5432/allset"
# Gere um valor real antes de subir o app — este placeholder é rejeitado por
# src/env.ts justamente para impedir que `cp .env.example .env` produza um app
# assinando sessões com um segredo público. Ex.: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-32+-char-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NODE_ENV="development"

# Evolution API (opcional até ativar a integração real)
EVOLUTION_BASE_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""
EVOLUTION_WEBHOOK_SECRET=""

# Protege o endpoint que o worker/cron chama para despachar a outbox e transcrever áudio.
# Gere-o antes de ativar o despacho remoto: openssl rand -base64 32
INTERNAL_JOB_SECRET=""

# Usada exclusivamente pelo adapter de transcrição Whisper (servidor apenas).
OPENAI_API_KEY=""

# Reengajamento automático de leads silenciosos durante o pré-cadastro.
# AFTER_HOURS: horas de inatividade antes do primeiro lembrete (padrão: 24).
# MAX_ATTEMPTS: máximo de lembretes por conversa (padrão: 2).
RECRUITMENT_REENGAGEMENT_AFTER_HOURS=""
RECRUITMENT_REENGAGEMENT_MAX_ATTEMPTS=""

# Horas até expiração de uma oportunidade não respondida (padrão: 4).
OPPORTUNITY_EXPIRY_HOURS=""

# Storage S3-compatível — MinIO em dev, AWS S3 ou similar em produção.
# Deixe em branco para usar o provider local (não funciona com Evolution em prod).
# Com `docker compose up -d minio`, use os valores abaixo como ponto de partida:
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="allset"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="allset"
S3_SECRET_ACCESS_KEY="allset1234"
# URL pública do MinIO quando o endpoint interno difere do externo (ex.: túnel, proxy).
# Necessária para que a Evolution consiga acessar URLs de áudio assinadas.
S3_PUBLIC_URL=""
