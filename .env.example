# ──────────────────────────────────────────────────────────────────────────────
# AllSet — variáveis de ambiente para VPS (Easypanel)
#
# Todos os serviços (app, PostgreSQL, MinIO, Evolution) rodam na mesma VPS.
# Os hostnames internos seguem o padrão do Easypanel: <projeto>_<serviço>
# onde <projeto> é o nome do projeto (ex.: allset_mvp).
#
# Para gerar secrets:  openssl rand -base64 32
# ──────────────────────────────────────────────────────────────────────────────

# ── Banco de dados ────────────────────────────────────────────────────────────
# Hostname interno do Easypanel — substitua <projeto> e <serviço-postgres>
# pelos nomes configurados no seu projeto Easypanel.
DATABASE_URL="postgresql://postgres:<senha>@<projeto>_<serviço-postgres>:5432/<banco>?sslmode=disable"

# ── Autenticação (Better Auth) ────────────────────────────────────────────────
# Gere um valor real: openssl rand -base64 32
# Este placeholder é rejeitado por src/env.ts para impedir app com segredo público.
BETTER_AUTH_SECRET="replace-with-32+-char-random-secret"
# URL pública do app — domínio gerado pelo Easypanel para o serviço da aplicação.
BETTER_AUTH_URL="https://<app>.vn6tpb.easypanel.host"

NODE_ENV="production"

# WhatsMiau Cloud (novo provider principal; veja docs/runbooks/whatsmiau-messaging.md)
WHATSMIAU_BASE_URL="https://api.whatsmiau.dev/v2"
WHATSMIAU_API_KEY=""
WHATSMIAU_INSTANCE="AllSet"
WHATSMIAU_WEBHOOK_SECRET=""
# Hosts exatos separados por virgula, sem esquema, porta ou wildcard.
WHATSMIAU_MEDIA_HOSTS="storage.whatsmiau.io"

# ── Evolution API (legado, opcional) ──────────────────────────────────────────
# Mantenha as env atuais durante o primeiro deploy de rollout.
# Para manter Evolution, configure as três juntas e o segredo abaixo.
# Exemplo de URL interna: http://<projeto>_<serviço-evolution>:8080
EVOLUTION_BASE_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""
# Número conectado ao WhatsApp, com código do país e apenas dígitos.
WHATSAPP_NUMBER="5585987231727"
# Gere: openssl rand -base64 32
EVOLUTION_WEBHOOK_SECRET=""

# ── Jobs internos e crons ─────────────────────────────────────────────────────
# Protege os endpoints HTTP de diagnostico manual; crontab nao e necessario.
# Gere: openssl rand -base64 32
# Scheduler interno: vazio = automatico em producao sem Redis; false desliga.
INTERNAL_SCHEDULER_ENABLED=""
INTERNAL_JOB_SECRET="<secret-interno>"
CRON_SECRET="<secret-cron>"

# ── Transcrição de áudio (Whisper via OpenAI) ─────────────────────────────────
OPENAI_API_KEY=""

# ── Comportamento de negócio ──────────────────────────────────────────────────
# Horas de inatividade antes do primeiro lembrete (padrão: 24)
RECRUITMENT_REENGAGEMENT_AFTER_HOURS=""
# Máximo de lembretes por conversa (padrão: 2)
RECRUITMENT_REENGAGEMENT_MAX_ATTEMPTS=""
CUSTOMER_REENGAGEMENT_AFTER_HOURS=""
# Horas até expirar uma oportunidade não respondida (padrão: 4)
OPPORTUNITY_EXPIRY_HOURS=""
# Horas sem avanço antes de um agendamento (pagamento/matching/revisão) ser
# considerado parado no painel admin (padrão: 24)
BOOKING_STALE_AFTER_HOURS=""

MESSAGING_DEFAULT_PROVIDER="whatsmiau"
# Intervalo mínimo global entre tentativas de envio pelo WhatsApp (padrão: 30s).
# Não existe intervalo que garanta proteção contra bloqueios do WhatsApp.
WHATSAPP_MESSAGE_INTERVAL_SECONDS="30"

# Chave PIX do negócio — pagamento vai para o admin, que repassa ao profissional.
PIX_KEY=""

# ── Storage S3-compatível (MinIO) ─────────────────────────────────────────────
# Endpoint interno para escrita (a aplicação envia arquivos via rede Docker).
S3_ENDPOINT="http://<projeto>_<serviço-minio>:9000"
S3_BUCKET="allset"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="<minio-access-key>"
S3_SECRET_ACCESS_KEY="<minio-secret-key>"
# URL pública para leitura — domínio externo do MinIO exposto pelo Easypanel.
# Usada para que a Evolution API consiga acessar URLs de áudio assinadas.
S3_PUBLIC_URL="https://<minio-publico>.vn6tpb.easypanel.host"
